"""
Read arguments from command line using sys.argv
"""
import pika
import os
import sys

ticker = sys.argv[1]
price = sys.argv[2]
sector = sys.argv[3]

# We'll first set up the connection and channel
connection = pika.BlockingConnection(
    pika.ConnectionParameters(host='localhost'))
channel = connection.channel()

# Declare the topic exchange
channel.exchange_declare(exchange='topic_logs', exchange_type='topic')

# Set the routing key and publish a message with that topic exchange:
routing_key = sys.argv[1] + '.' + sys.argv[2] + '.' + sys.argv[3]
message = "The ticker is: " + ticker + ", the price is: " + price + ", and the sector is: " + sector    
channel.basic_publish(
    exchange='topic_logs', routing_key=routing_key, body=message)
print(f" [x] Sent {routing_key}:{message}")